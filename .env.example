# Local (uvicorn) — SQLite file under smartcity-iiith/data/
DATABASE_URL=sqlite:///./data/clinic.db
STORAGE_DIR=./data/storage
MODEL_PATH=../ml/artifacts/model.pt
YOLO_MODEL_PATH=../ml/artifacts/yolov8n.pt
MAX_UPLOAD_BYTES=10485760
GRID_SIZE=16
MAX_ANALYSIS_DIM=512
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
JWT_SECRET=dev-change-me-clinic-jwt
VITE_API_URL=

# Docker Compose overrides DATABASE_URL to Postgres:
# postgresql+psycopg2://clinic:clinic@postgres:5432/clinic
